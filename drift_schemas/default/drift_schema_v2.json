          "sql": "CREATE TABLE IF NOT EXISTS \"sites\" (\"id\" TEXT NOT NULL, \"association_id\" TEXT NOT NULL, \"entered_by\" TEXT NOT NULL, \"observed_by\" TEXT NULL, \"created_at_device\" TEXT NOT NULL, \"device_id\" TEXT NOT NULL, \"server_received_at\" TEXT NULL, \"server_seq\" INTEGER NULL, \"sync_state\" TEXT NOT NULL DEFAULT 'pending', \"sync_error\" TEXT NULL, \"updated_at_device\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"location_note\" TEXT NULL, PRIMARY KEY (\"id\"));"
